# Art-track working files that stay local (no Git LFS in this repo; nothing > 20 MB is committed).
# Every ignored raw output is recorded (path, bytes, sha256) in art/characters/<char>/manifest.json.

# Raw generator output: TRELLIS.2 GLBs (60-90 MB) and the ComfyUI conditioning/mask previews.
# The provenance JSON next to each GLB is small and IS committed.
characters/*/source/*
!characters/*/source/*.json

# Scratch: full-resolution renders, mask checks, logs, heavy .blend files.
characters/*/work/

# Size cannot be expressed here: anything else over 20 MB (a huge PNG in references/ or reports/)
# is rejected by tools/comfy/check_art.py (CI: .github/workflows/art.yml). Run it before committing.

# Blender autosave / backup files anywhere under art/
*.blend1
*.blend2
*.blend@
