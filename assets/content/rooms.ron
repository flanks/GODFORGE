    // ─────────────────────────── BIOME MAPS (OPEN_WORLD.md) ───────────────────────────
    // One Expedition template per biome: `gf_content::worldgen` generates the whole biome map from
    // (template, seed), and a biome plays it with `sequence: [Fixed(Expedition), Fixed(Boss)]`.
    // Everything below `expedition:` is generation input; how POIs, the horde and the gate *play*
    // lives in game.ron `expedition`. Preview with
    // `cargo run -p gf_tools -- preview-room cinder_expedition 7 shots/cinder_map_7.png --scale 2`.
    (
        key: "cinder_expedition",
        biome: "cinder_wastes",
        kind: Expedition,
        phase: P0,
        // Must be expedition.size / 2. The Landing replaces this spawn, the Boss Gate the exits.
        half_extents: (216.0, 136.0),
        player_spawn: (0.0, 0.0),
        // Stress mode only (`--stress`): the director v2 spawns around each player cluster.
        spawn_zones: [Around(min: 27.0, max: 34.0)],
        // The horde comes from the threat clock below; the legacy budget stays empty.
        encounter: (budget: 0.0, duration: 1.0, rate_start: 0.0, rate_end: 0.0, max_alive: 400, elite_chance: 0.0),
        expedition: (
            // ~9.6 × 9.7 screens at 4P; a straight crossing takes 60–75 s.
            size: (432.0, 272.0),
            regions: (5, 3),
            start_theme: "slag_flats",
            // Region themes: each region's slots are filled from its `districts` pool (room-grammar
            // compositions), `fields` of them stay open killing ground, `cover` tops up ruins.
            // Camps draw their pack from `camp_pool` (one enemy kind per camp, 6–12 strong; bombers
            // stay out of camps, a dozen sleeping kindlejacks is a wipe, not a fight).
            themes: [
                (
                    key: "slag_flats",
                    name: "The Slag Flats",
                    weight: 1.3,
                    open: true,
                    fields: 0.6,
                    cover: 0.025,
                    districts: [(SlagChannel, 1.0), (CrucibleYard, 0.6)],
                    tint: "#3A2418",
                    map_color: "#5A3A28",
                    camp_pool: [(key: "cinderling", weight: 1.0), (key: "emberwisp", weight: 0.6), (key: "slagspitter", weight: 0.3)],
                ),
                (
                    key: "foundry_ruins",
                    name: "Foundry Ruins",
                    weight: 1.0,
                    fields: 0.2,
                    cover: 0.055,
                    districts: [(ForgeHall, 1.4), (CrucibleYard, 0.8), (ColonnadeCourt, 0.5)],
                    tint: "#2E1E17",
                    map_color: "#4A3226",
                    camp_pool: [(key: "clinker", weight: 1.0), (key: "cinderling", weight: 0.7), (key: "slagspitter", weight: 0.4)],
                ),
                (
                    key: "colonnade_of_oaths",
                    name: "Colonnade of Oaths",
                    weight: 0.9,
                    fields: 0.25,
                    cover: 0.05,
                    districts: [(ColonnadeCourt, 1.5), (ForgeHall, 0.4)],
                    tint: "#34261E",
                    map_color: "#56443A",
                    camp_pool: [(key: "ashrunner", weight: 1.0), (key: "cinderling", weight: 0.6), (key: "emberwisp", weight: 0.4)],
                ),
                (
                    key: "cinder_dunes",
                    name: "Cinder Dunes",
                    weight: 0.8,
                    open: true,
                    fields: 0.75,
                    cover: 0.02,
                    districts: [(SlagChannel, 0.6)],
                    tint: "#2A1E1A",
                    map_color: "#3E302A",
                    camp_pool: [(key: "ashrunner", weight: 1.0), (key: "clinker", weight: 0.8), (key: "emberwisp", weight: 0.5)],
                ),
                (
                    key: "chainyard",
                    name: "The Chainyard",
                    weight: 0.7,
                    fields: 0.3,
                    cover: 0.045,
                    districts: [(CrucibleYard, 1.4), (ForgeHall, 0.6)],
                    tint: "#301C14",
                    map_color: "#4E2E22",
                    camp_pool: [(key: "clinker", weight: 1.0), (key: "slagspitter", weight: 0.5), (key: "cinderling", weight: 0.5)],
                ),
            ],
            // Coast in tiles (4 u): bays and headlands up to ~20 u deep.
            coast: (depth: 2, amp: 3, period: 6),
            // Slag rivers (pits, bridged at the road passes) and forge walls (breached at the passes).
            barriers: (chance: 0.45, kinds: [(River, 0.30), (Wall, 0.15)]),
            roads: (width: 6.0, loop_chance: 0.3, pass_width: 8.0),
            // 14 Seals on offer, 6 open the gate (the Warlord's 2 included). No Gate quota: the gate
            // is implicit. The Watchfire quota arrives in phase 3.
            pois: [
                (kind: Anvil, count: 3, seals: 1),
                (kind: Warlord, count: 1, seals: 2),
                (kind: Lair, count: 2, seals: 1),
                (kind: Shrine, count: 3, seals: 1),
                (kind: Reliquary, count: 2, seals: 1),
                (kind: Vein, count: 2, seals: 1),
                (kind: Spring, count: 3, seals: 0),
            ],
            camps: (per_area: 4000.0, pack: (6, 12), elite_chance: 0.2, shards: (8, 15)),
            // Grand monuments for regions without a major POI (phase 4 adds FallenWeapon).
            landmarks: [(GreatAnvil, 1.0), (Statue, 1.0), (ColossusHead, 0.8), (GreatBrazier, 0.8), (SealedGate, 0.5)],
            seals_required: 7,
            gate_requires_warlord: true,
            gate_force_minute: 12.0,
            // Today's boss after 7 rooms (hp_growth_per_room 0.05 × 7).
            boss_hp_mult: 1.35,
            threat_start_minute: 0.0,
            // The threat clock (§2.5), for one solo cluster: a cluster of n players multiplies
            // density and rate by party_scaling(n).enemy_count. Rows interpolate linearly; past the
            // last row its slope continues, capped by horde.global_max_alive. The clock runs at
            // stage minutes + horde.heat_per_objective per completed objective.
            threat: [
                (minute: 0.0, density: 30.0, rate: 3.0, elite_chance: 0.01, hp_mult: 1.0),
                (minute: 3.0, density: 60.0, rate: 5.0, elite_chance: 0.03, hp_mult: 1.1),
                (minute: 6.0, density: 100.0, rate: 7.5, elite_chance: 0.05, hp_mult: 1.25),
                (minute: 9.0, density: 140.0, rate: 10.0, elite_chance: 0.07, hp_mult: 1.45),
                (minute: 12.0, density: 175.0, rate: 12.5, elite_chance: 0.08, hp_mult: 1.65),
                (minute: 15.0, density: 200.0, rate: 14.0, elite_chance: 0.09, hp_mult: 1.9),
            ],
        ),
    ),
]
